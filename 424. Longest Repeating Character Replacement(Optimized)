//recalculating maxC only required when Question asking for maxC

class Solution {
    public int characterReplacement(String s, int k) {
        int max = 0;
        int maxC = 0;
        int j = 0;
        int i = 0;

      int[] counts = new int[26];
        while(j < s.length()) {
            char c = s.charAt(j);
        
        counts[c - 'A'] = counts[c-'A'] + 1;
        maxC = Math.max(maxC,counts[c-'A']);
        while((j-i+1) - maxC > k) {
            char q = s.charAt(i);
             counts[q - 'A']--;;
            i++;

     int newMax = 0;
    for (int d : counts) {
        newMax = Math.max(newMax, d);
    }
    maxC = newMax;
        }
        max = Math.max(max,j-i+1);
        j++;

        }
        return max;
        
    }
}
